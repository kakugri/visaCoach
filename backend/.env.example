# Backend runtime configuration.
# Copy this file to backend/.env and fill in real values locally.

NODE_ENV=development
HOST=127.0.0.1
PORT=5000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MONGODB_URI=mongodb://localhost:27017/visacoach
JWT_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20
ANALYTICS_RATE_LIMIT_WINDOW_MS=60000
ANALYTICS_RATE_LIMIT_MAX=120
JSON_BODY_LIMIT=100kb
REQUEST_LOGGING=true
LOG_LEVEL=info
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
